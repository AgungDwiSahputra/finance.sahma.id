---
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Toast from '../components/ui/Toast.astro';
---

<AppLayout title="Dashboard" activeNav="dashboard">
  <Toast />

  <!-- Header -->
  <header class="px-4 pt-8 pb-4 flex items-center justify-between">
    <div>
      <p class="text-gray-400 text-sm">Selamat datang 👋</p>
      <h1 class="text-gray-900 font-bold text-lg leading-tight" id="greeting-name">
        <span class="inline-block w-28 h-5 bg-gray-100 rounded animate-pulse"></span>
      </h1>
    </div>
    <button id="btn-logout" title="Keluar"
      class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center hover:bg-gray-200 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h6a2 2 0 012 2v1" />
      </svg>
    </button>
  </header>

  <!-- ── Filter Periode ──────────────────────────────────── -->
  <div class="px-4 mb-4">
    <!-- Pills -->
    <div class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none;">
      <button data-mode="bulan-ini"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-blue-600 text-white shadow-sm">
        Bulan Ini
      </button>
      <button data-mode="pilih-bulan"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Pilih Bulan
      </button>
      <button data-mode="semua"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Semua
      </button>
      <button data-mode="custom"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Custom
      </button>
    </div>

    <!-- Input: Pilih Bulan -->
    <div id="input-pilih-bulan" class="hidden mt-3">
      <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-xl px-4 py-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <input id="month-picker" type="month"
          class="flex-1 bg-transparent text-sm text-gray-700 focus:outline-none" />
      </div>
    </div>

    <!-- Input: Custom Range -->
    <div id="input-custom" class="hidden mt-3 grid grid-cols-2 gap-2">
      <div>
        <label class="block text-xs text-gray-400 mb-1">Dari tanggal</label>
        <input id="custom-from" type="date"
          class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">Sampai tanggal</label>
        <input id="custom-to" type="date"
          class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
      </div>
    </div>
  </div>

  <!-- Kartu Saldo Utama -->
  <div class="px-4 mb-4">
    <div class="bg-gradient-to-br from-blue-600 to-blue-800 rounded-2xl p-5 text-white shadow-lg">
      <p class="text-blue-200 text-xs font-medium uppercase tracking-wide mb-1">Total Saldo</p>
      <p class="text-3xl font-bold tracking-tight mb-4" id="saldo-total">
        <span class="inline-block w-40 h-8 bg-white/20 rounded-lg animate-pulse"></span>
      </p>
      <p class="text-blue-200 text-xs" id="label-periode">—</p>
    </div>
  </div>

  <!-- Ringkasan Pemasukan & Pengeluaran -->
  <div class="px-4 mb-6 grid grid-cols-2 gap-3">
    <Card>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-8 h-8 bg-emerald-50 rounded-lg flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 11l5-5m0 0l5 5m-5-5v12" />
          </svg>
        </span>
        <span class="text-xs text-gray-400 font-medium">Pemasukan</span>
      </div>
      <p class="text-emerald-600 font-bold text-base" id="total-masuk">
        <span class="inline-block w-20 h-5 bg-gray-100 rounded animate-pulse"></span>
      </p>
    </Card>

    <Card>
      <div class="flex items-center gap-2 mb-2">
        <span class="w-8 h-8 bg-rose-50 rounded-lg flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 13l-5 5m0 0l-5-5m5 5V6" />
          </svg>
        </span>
        <span class="text-xs text-gray-400 font-medium">Pengeluaran</span>
      </div>
      <p class="text-rose-600 font-bold text-base" id="total-keluar">
        <span class="inline-block w-20 h-5 bg-gray-100 rounded animate-pulse"></span>
      </p>
    </Card>
  </div>

  <!-- Transaksi Terakhir -->
  <div class="px-4">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-gray-800 font-semibold text-sm" id="label-transaksi">Transaksi Terakhir</h2>
      <a href={`${import.meta.env.BASE_URL}riwayat`} class="text-blue-600 text-xs font-medium hover:underline">Lihat semua</a>
    </div>

    <div id="empty-transaksi" class="hidden">
      <EmptyState
        icon="📊"
        title="Belum ada transaksi"
        description="Mulai catat pengeluaran atau pemasukan pertama Anda hari ini."
        actionLabel="+ Tambah Transaksi"
        actionHref={`${import.meta.env.BASE_URL}tambah`}
      />
    </div>

    <div id="list-transaksi" class="hidden flex-col gap-2"></div>

    <div id="skeleton-transaksi" class="flex flex-col gap-2">
      {Array.from({ length: 4 }).map(() => (
        <div class="bg-white rounded-xl border border-gray-100 px-4 py-3 flex items-center gap-3 animate-pulse">
          <div class="w-10 h-10 bg-gray-100 rounded-xl shrink-0"></div>
          <div class="flex-1 space-y-2">
            <div class="h-3.5 bg-gray-100 rounded w-3/4"></div>
            <div class="h-3 bg-gray-100 rounded w-1/2"></div>
          </div>
          <div class="h-4 bg-gray-100 rounded w-16"></div>
        </div>
      ))}
    </div>
  </div>
</AppLayout>

<script>
  import { supabase }    from '../lib/supabase';
  import { requireAuth } from '../lib/auth-guard';
  import {
    formatRupiah,
    getCurrentMonthRange,
    monthRangeFromFilter,
  } from '../lib/format';
  import type { Transaction } from '../lib/types';

  const toast = (msg: string, type: 'success'|'error'|'info' = 'info') =>
    (window as any).showToast?.(msg, type);

  // ── Auth guard ────────────────────────────────────────────
  const session = await requireAuth();
  if (!session) throw new Error('redirect');

  // ── Nama pengguna ─────────────────────────────────────────
  const displayName =
    session.user.user_metadata?.full_name ||
    session.user.email?.split('@')[0] ||
    'Pengguna';
  document.getElementById('greeting-name')!.textContent = displayName;

  // ── State filter ──────────────────────────────────────────
  type FilterMode = 'bulan-ini' | 'pilih-bulan' | 'semua' | 'custom';
  let mode: FilterMode = 'bulan-ini';

  // Set nilai default input bulan ke bulan ini
  const now = new Date();
  const monthPickerEl = document.getElementById('month-picker') as HTMLInputElement;
  monthPickerEl.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;

  // Set nilai default custom-to ke hari ini
  const todayStr = now.toISOString().split('T')[0];
  (document.getElementById('custom-to') as HTMLInputElement).value = todayStr;

  // ── Hitung rentang tanggal sesuai mode ────────────────────
  function getDateRange(): { from: string | null; to: string | null } {
    if (mode === 'bulan-ini')   return getCurrentMonthRange();
    if (mode === 'pilih-bulan') {
      const val = monthPickerEl.value;
      return val ? monthRangeFromFilter(val) : getCurrentMonthRange();
    }
    if (mode === 'semua') return { from: null, to: null };
    // custom
    const from = (document.getElementById('custom-from') as HTMLInputElement).value || null;
    const to   = (document.getElementById('custom-to')   as HTMLInputElement).value || null;
    if (from && to && from > to) {
      toast('Tanggal "Dari" tidak boleh lebih besar dari "Sampai".', 'error');
      return { from: null, to: null };
    }
    return { from, to };
  }

  // ── Label periode untuk kartu saldo ──────────────────────
  function getPeriodLabel(from: string | null, to: string | null): string {
    if (mode === 'semua') return 'Semua Waktu';
    if (!from)            return '—';
    if (mode === 'bulan-ini' || mode === 'pilih-bulan') {
      return new Date(from + 'T00:00:00').toLocaleDateString('id-ID', {
        month: 'long', year: 'numeric',
      });
    }
    // custom
    const f = new Date(from + 'T00:00:00').toLocaleDateString('id-ID', {
      day: 'numeric', month: 'short', year: 'numeric',
    });
    const t = to
      ? new Date(to + 'T00:00:00').toLocaleDateString('id-ID', {
          day: 'numeric', month: 'short', year: 'numeric',
        })
      : 'sekarang';
    return `${f} — ${t}`;
  }

  // ── Render skeleton / hide skeleton ───────────────────────
  function showLoading() {
    document.getElementById('skeleton-transaksi')!.classList.remove('hidden');
    document.getElementById('list-transaksi')!.classList.add('hidden');
    document.getElementById('empty-transaksi')!.classList.add('hidden');
    document.getElementById('saldo-total')!.innerHTML =
      '<span class="inline-block w-40 h-8 bg-white/20 rounded-lg animate-pulse"></span>';
    document.getElementById('total-masuk')!.innerHTML =
      '<span class="inline-block w-20 h-5 bg-gray-100 rounded animate-pulse"></span>';
    document.getElementById('total-keluar')!.innerHTML =
      '<span class="inline-block w-20 h-5 bg-gray-100 rounded animate-pulse"></span>';
  }

  // ── Fetch dan render data ─────────────────────────────────
  async function loadData() {
    const { from, to } = getDateRange();
    showLoading();

    // Update label periode
    document.getElementById('label-periode')!.textContent = getPeriodLabel(from, to);

    // Update judul list
    document.getElementById('label-transaksi')!.textContent =
      mode === 'semua' ? '5 Transaksi Terakhir' : 'Transaksi Terakhir';

    // Helper: terapkan filter tanggal ke query
    function applyDates(q: any) {
      if (from) q = q.gte('transaction_date', from);
      if (to)   q = q.lte('transaction_date', to);
      return q;
    }

    // Query 1: total untuk ringkasan (semua data, kolom minimal)
    const summaryQ = applyDates(
      supabase
        .from('transactions')
        .select('amount, categories!inner(type)')
        .eq('user_id', session.user.id)
    );

    // Query 2: 5 transaksi terbaru untuk preview
    const previewQ = applyDates(
      supabase
        .from('transactions')
        .select('*, categories(id, name, type, icon)')
        .eq('user_id', session.user.id)
        .order('transaction_date', { ascending: false })
        .order('created_at',       { ascending: false })
        .limit(5)
    );

    const [{ data: summaryData, error: errSum }, { data: previewData, error: errPrev }] =
      await Promise.all([summaryQ, previewQ]);

    if (errSum || errPrev) {
      toast('Gagal memuat data. Periksa koneksi Anda.', 'error');
    }

    // Hitung ringkasan
    let totalMasuk = 0, totalKeluar = 0;
    (summaryData ?? []).forEach((tx: any) => {
      if (tx.categories?.type === 'income')  totalMasuk  += Number(tx.amount);
      if (tx.categories?.type === 'expense') totalKeluar += Number(tx.amount);
    });

    document.getElementById('saldo-total')!.textContent  = formatRupiah(totalMasuk - totalKeluar);
    document.getElementById('total-masuk')!.textContent  = formatRupiah(totalMasuk);
    document.getElementById('total-keluar')!.textContent = formatRupiah(totalKeluar);

    // Render preview transaksi
    const skeleton = document.getElementById('skeleton-transaksi')!;
    const listEl   = document.getElementById('list-transaksi')!;
    const emptyEl  = document.getElementById('empty-transaksi')!;

    skeleton.classList.add('hidden');

    const txList = (previewData ?? []) as Transaction[];
    if (txList.length === 0) {
      emptyEl.classList.remove('hidden');
    } else {
      listEl.classList.replace('hidden', 'flex');
      listEl.innerHTML = txList.map((tx) => {
        const cat      = tx.categories;
        const isIncome = cat?.type === 'income';
        const icon     = cat?.icon || '📦';
        const name     = cat?.name || 'Lainnya';
        const sign     = isIncome ? '+' : '-';
        const color    = isIncome ? 'text-emerald-600' : 'text-rose-600';
        const dateStr  = new Date(tx.transaction_date + 'T00:00:00')
          .toLocaleDateString('id-ID', { day: 'numeric', month: 'short' });

        return `
          <div class="bg-white rounded-xl border border-gray-100 px-4 py-3 flex items-center gap-3">
            <span class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-xl shrink-0">${icon}</span>
            <div class="flex-1 min-w-0">
              <p class="text-gray-900 text-sm font-medium truncate">${name}</p>
              <p class="text-gray-400 text-xs truncate">${tx.description || dateStr}</p>
            </div>
            <p class="font-semibold text-sm shrink-0 ${color}">${sign}${formatRupiah(tx.amount)}</p>
          </div>`;
      }).join('');
    }
  }

  // ── Switcher pills ────────────────────────────────────────
  function setMode(newMode: FilterMode) {
    mode = newMode;

    // Update tampilan pill
    document.querySelectorAll('.filter-pill').forEach((btn) => {
      const m = (btn as HTMLElement).dataset.mode as FilterMode;
      if (m === mode) {
        btn.className = 'filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-blue-600 text-white shadow-sm';
      } else {
        btn.className = 'filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200';
      }
    });

    // Tampil/sembunyikan input tambahan
    document.getElementById('input-pilih-bulan')!.classList.toggle('hidden', mode !== 'pilih-bulan');
    document.getElementById('input-custom')!.classList.toggle('hidden',       mode !== 'custom');

    // Langsung load kecuali mode yang butuh input manual
    if (mode !== 'pilih-bulan' && mode !== 'custom') loadData();
  }

  // Event: klik pill
  document.querySelectorAll('.filter-pill').forEach((btn) => {
    btn.addEventListener('click', () => setMode((btn as HTMLElement).dataset.mode as FilterMode));
  });

  // Event: pilih bulan
  monthPickerEl.addEventListener('change', () => loadData());

  // Event: custom range (debounce 600ms agar tidak fetch tiap keystroke)
  let debounceTimer: ReturnType<typeof setTimeout>;
  ['custom-from', 'custom-to'].forEach((id) => {
    document.getElementById(id)?.addEventListener('change', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => loadData(), 600);
    });
  });

  // ── Logout ────────────────────────────────────────────────
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.replace(import.meta.env.BASE_URL + 'login');
  });

  // ── Load awal ─────────────────────────────────────────────
  loadData();
</script>
