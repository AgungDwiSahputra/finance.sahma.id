---
import AppLayout from '../layouts/AppLayout.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Toast from '../components/ui/Toast.astro';
---

<AppLayout title="Riwayat Transaksi" activeNav="riwayat">
  <Toast />

  <!-- Header -->
  <header class="px-4 pt-8 pb-4">
    <h1 class="text-gray-900 font-bold text-xl">Riwayat</h1>
    <p class="text-gray-400 text-sm mt-0.5">Semua catatan transaksi Anda</p>
  </header>

  <!-- Filter Bulan -->
  <div class="px-4 mb-4">
    <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-xl px-4 py-2.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <input
        id="filter-bulan"
        type="month"
        class="flex-1 bg-transparent text-sm text-gray-700 focus:outline-none"
      />
    </div>
  </div>

  <!-- Ringkasan Bulan -->
  <div class="px-4 mb-4 grid grid-cols-2 gap-3">
    <div class="bg-emerald-50 rounded-xl px-4 py-3">
      <p class="text-emerald-600 text-xs font-medium mb-0.5">Total Masuk</p>
      <p class="text-emerald-700 font-bold text-base" id="filter-masuk">Rp 0</p>
    </div>
    <div class="bg-rose-50 rounded-xl px-4 py-3">
      <p class="text-rose-600 text-xs font-medium mb-0.5">Total Keluar</p>
      <p class="text-rose-700 font-bold text-base" id="filter-keluar">Rp 0</p>
    </div>
  </div>

  <!-- Daftar Transaksi (dikelompokkan per tanggal) -->
  <div id="list-container" class="px-4 flex flex-col gap-4">

    <!-- Empty State -->
    <div id="empty-riwayat">
      <EmptyState
        icon="🗂️"
        title="Belum ada transaksi"
        description="Tidak ada transaksi di bulan yang dipilih."
        actionLabel="+ Tambah Sekarang"
        actionHref="/tambah"
      />
    </div>

    <!-- Kontainer grup transaksi per tanggal (diisi via JS dari Supabase) -->
    <div id="groups-container" class="hidden flex flex-col gap-6">
      <!--
        Contoh struktur grup:
        <div>
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Senin, 3 Juni 2026</p>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 divide-y divide-gray-50">
            [item transaksi]
          </div>
        </div>
      -->
    </div>

    <!-- Loading state -->
    <div id="loading-riwayat" class="hidden py-12 flex items-center justify-center">
      <svg class="w-8 h-8 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
    </div>

    <!-- Pagination / Load More -->
    <div id="load-more-container" class="hidden pb-4">
      <button
        id="btn-load-more"
        class="w-full py-3 border border-gray-200 rounded-xl text-sm text-gray-500 font-medium hover:bg-gray-50 transition-colors"
      >
        Muat lebih banyak
      </button>
    </div>

  </div>
</AppLayout>

<script>
  // Set filter bulan default ke bulan ini
  const filterBulan = document.getElementById('filter-bulan') as HTMLInputElement;
  if (filterBulan) {
    const now = new Date();
    filterBulan.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  }

  // Logika fetch & render transaksi akan disambungkan di Langkah 5
  console.log('[Riwayat] UI siap — data akan di-fetch dari Supabase di Langkah 5');
</script>
