---
import AppLayout from '../layouts/AppLayout.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Toast from '../components/ui/Toast.astro';
---

<AppLayout title="Riwayat Transaksi" activeNav="riwayat">
  <Toast />

  <header class="px-4 pt-8 pb-4">
    <h1 class="text-gray-900 font-bold text-xl">Riwayat</h1>
    <p class="text-gray-400 text-sm mt-0.5">Semua catatan transaksi Anda</p>
  </header>

  <!-- ── Filter Periode ──────────────────────────────────── -->
  <div class="px-4 mb-4">
    <!-- Pills -->
    <div class="flex gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none;">
      <button data-mode="bulan-ini"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-blue-600 text-white shadow-sm">
        Bulan Ini
      </button>
      <button data-mode="pilih-bulan"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Pilih Bulan
      </button>
      <button data-mode="semua"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Semua
      </button>
      <button data-mode="custom"
        class="filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200">
        Custom
      </button>
    </div>

    <!-- Input: Pilih Bulan -->
    <div id="input-pilih-bulan" class="hidden mt-3">
      <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-xl px-4 py-2.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <input id="month-picker" type="month"
          class="flex-1 bg-transparent text-sm text-gray-700 focus:outline-none" />
      </div>
    </div>

    <!-- Input: Custom Range -->
    <div id="input-custom" class="hidden mt-3 grid grid-cols-2 gap-2">
      <div>
        <label class="block text-xs text-gray-400 mb-1">Dari tanggal</label>
        <input id="custom-from" type="date"
          class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
      </div>
      <div>
        <label class="block text-xs text-gray-400 mb-1">Sampai tanggal</label>
        <input id="custom-to" type="date"
          class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
      </div>
    </div>
  </div>

  <!-- Ringkasan Periode -->
  <div class="px-4 mb-4">
    <p class="text-xs text-gray-400 font-medium mb-2" id="label-periode">—</p>
    <div class="grid grid-cols-2 gap-3">
      <div class="bg-emerald-50 rounded-xl px-4 py-3">
        <p class="text-emerald-600 text-xs font-medium mb-0.5">Total Masuk</p>
        <p class="text-emerald-700 font-bold text-base" id="filter-masuk">
          <span class="inline-block w-20 h-5 bg-emerald-100 rounded animate-pulse"></span>
        </p>
      </div>
      <div class="bg-rose-50 rounded-xl px-4 py-3">
        <p class="text-rose-600 text-xs font-medium mb-0.5">Total Keluar</p>
        <p class="text-rose-700 font-bold text-base" id="filter-keluar">
          <span class="inline-block w-20 h-5 bg-rose-100 rounded animate-pulse"></span>
        </p>
      </div>
    </div>
  </div>

  <!-- Kontainer utama -->
  <div id="list-container" class="px-4 flex flex-col gap-4">
    <div id="loading-riwayat" class="py-12 flex items-center justify-center">
      <svg class="w-8 h-8 animate-spin text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
    </div>

    <div id="empty-riwayat" class="hidden">
      <EmptyState icon="🗂️" title="Belum ada transaksi"
        description="Tidak ada transaksi di periode yang dipilih."
        actionLabel="+ Tambah Sekarang"
        actionHref={`${import.meta.env.BASE_URL}tambah`} />
    </div>

    <div id="groups-container" class="hidden flex-col gap-6"></div>

    <div id="load-more-container" class="hidden pb-4">
      <button id="btn-load-more"
        class="w-full py-3 border border-gray-200 rounded-xl text-sm text-gray-500 font-medium hover:bg-gray-50 transition-colors">
        Muat lebih banyak
      </button>
    </div>
  </div>
</AppLayout>

<script>
  import { supabase }    from '../lib/supabase';
  import { requireAuth } from '../lib/auth-guard';
  import {
    formatRupiah,
    formatDateGroup,
    getCurrentMonthRange,
    monthRangeFromFilter,
  } from '../lib/format';
  import type { Transaction } from '../lib/types';

  const toast = (msg: string, type: 'success'|'error'|'info' = 'info') =>
    (window as any).showToast?.(msg, type);

  const PAGE_SIZE = 20;

  // ── Auth guard ────────────────────────────────────────────
  const session = await requireAuth();
  if (!session) throw new Error('redirect');

  // ── State ─────────────────────────────────────────────────
  type FilterMode = 'bulan-ini' | 'pilih-bulan' | 'semua' | 'custom';
  let mode          : FilterMode    = 'bulan-ini';
  let currentOffset : number        = 0;
  let allLoaded     : boolean       = false;
  let activeFrom    : string | null = null; // range yang sedang ditampilkan
  let activeTo      : string | null = null;

  // ── DOM refs ──────────────────────────────────────────────
  const loadingEl     = document.getElementById('loading-riwayat')!;
  const emptyEl       = document.getElementById('empty-riwayat')!;
  const groupsEl      = document.getElementById('groups-container')!;
  const loadMoreCont  = document.getElementById('load-more-container')!;
  const btnLoadMore   = document.getElementById('btn-load-more')!;
  const totalMasukEl  = document.getElementById('filter-masuk')!;
  const totalKeluarEl = document.getElementById('filter-keluar')!;
  const labelEl       = document.getElementById('label-periode')!;
  const monthPickerEl = document.getElementById('month-picker')  as HTMLInputElement;
  const customFromEl  = document.getElementById('custom-from')   as HTMLInputElement;
  const customToEl    = document.getElementById('custom-to')     as HTMLInputElement;

  // Set nilai default input
  const now = new Date();
  monthPickerEl.value = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  customToEl.value    = now.toISOString().split('T')[0];

  // ── Hitung rentang tanggal sesuai mode ────────────────────
  function getDateRange(): { from: string | null; to: string | null } | null {
    if (mode === 'bulan-ini')   return getCurrentMonthRange();
    if (mode === 'pilih-bulan') {
      const val = monthPickerEl.value;
      return val ? monthRangeFromFilter(val) : getCurrentMonthRange();
    }
    if (mode === 'semua') return { from: null, to: null };
    // custom
    const from = customFromEl.value || null;
    const to   = customToEl.value   || null;
    if (from && to && from > to) {
      toast('Tanggal "Dari" tidak boleh lebih besar dari "Sampai".', 'error');
      return null;
    }
    return { from, to };
  }

  // ── Label periode ─────────────────────────────────────────
  function getPeriodLabel(from: string | null, to: string | null): string {
    if (mode === 'semua') return 'Semua Waktu';
    if (!from)            return '—';
    if (mode === 'bulan-ini' || mode === 'pilih-bulan') {
      return new Date(from + 'T00:00:00').toLocaleDateString('id-ID', {
        month: 'long', year: 'numeric',
      });
    }
    const f = new Date(from + 'T00:00:00').toLocaleDateString('id-ID', {
      day: 'numeric', month: 'short', year: 'numeric',
    });
    const t = to
      ? new Date(to + 'T00:00:00').toLocaleDateString('id-ID', {
          day: 'numeric', month: 'short', year: 'numeric',
        })
      : 'sekarang';
    return `${f} — ${t}`;
  }

  // ── Terapkan filter tanggal ke query ─────────────────────
  function applyDates(q: any, from: string | null, to: string | null) {
    if (from) q = q.gte('transaction_date', from);
    if (to)   q = q.lte('transaction_date', to);
    return q;
  }

  // ── Fetch & render (append = load more) ──────────────────
  async function fetchTransactions(append = false) {
    if (!append) {
      const range = getDateRange();
      if (!range) return; // validasi custom gagal

      activeFrom    = range.from;
      activeTo      = range.to;
      currentOffset = 0;
      allLoaded     = false;

      // Reset UI
      loadingEl.classList.remove('hidden');
      emptyEl.classList.add('hidden');
      groupsEl.classList.add('hidden');
      loadMoreCont.classList.add('hidden');
      totalMasukEl.innerHTML  = '<span class="inline-block w-20 h-5 bg-emerald-100 rounded animate-pulse"></span>';
      totalKeluarEl.innerHTML = '<span class="inline-block w-20 h-5 bg-rose-100 rounded animate-pulse"></span>';
      labelEl.textContent     = getPeriodLabel(activeFrom, activeTo);
    }

    const txQuery = applyDates(
      supabase
        .from('transactions')
        .select('*, categories(id, name, type, icon)')
        .eq('user_id', session.user.id)
        .order('transaction_date', { ascending: false })
        .order('created_at',       { ascending: false })
        .range(currentOffset, currentOffset + PAGE_SIZE - 1),
      activeFrom, activeTo
    );

    const { data, error } = await txQuery;
    loadingEl.classList.add('hidden');

    if (error) {
      toast('Gagal memuat riwayat. Periksa koneksi Anda.', 'error');
      return;
    }

    const txList = (data ?? []) as Transaction[];

    if (!append && txList.length === 0) {
      emptyEl.classList.remove('hidden');
      totalMasukEl.textContent  = formatRupiah(0);
      totalKeluarEl.textContent = formatRupiah(0);
      return;
    }

    if (!append) {
      await updateSummary(activeFrom, activeTo);
      groupsEl.innerHTML = '';
    }

    groupsEl.classList.replace('hidden', 'flex');
    renderGroups(txList);

    currentOffset += txList.length;
    allLoaded = txList.length < PAGE_SIZE;
    loadMoreCont.classList.toggle('hidden', allLoaded);
  }

  // ── Hitung & tampilkan ringkasan ─────────────────────────
  async function updateSummary(from: string | null, to: string | null) {
    const { data } = await applyDates(
      supabase
        .from('transactions')
        .select('amount, categories(type)')
        .eq('user_id', session.user.id),
      from, to
    );

    let masuk = 0, keluar = 0;
    (data ?? []).forEach((tx: any) => {
      if (tx.categories?.type === 'income')  masuk  += Number(tx.amount);
      if (tx.categories?.type === 'expense') keluar += Number(tx.amount);
    });

    totalMasukEl.textContent  = formatRupiah(masuk);
    totalKeluarEl.textContent = formatRupiah(keluar);
  }

  // ── Render grup transaksi per tanggal ─────────────────────
  function renderGroups(txList: Transaction[]) {
    const grouped = new Map<string, Transaction[]>();
    txList.forEach((tx) => {
      if (!grouped.has(tx.transaction_date)) grouped.set(tx.transaction_date, []);
      grouped.get(tx.transaction_date)!.push(tx);
    });

    grouped.forEach((items, dateKey) => {
      let groupEl = groupsEl.querySelector(`[data-date="${dateKey}"]`) as HTMLElement | null;

      if (!groupEl) {
        groupEl = document.createElement('div');
        groupEl.dataset.date = dateKey;
        groupEl.innerHTML = `
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">
            ${formatDateGroup(dateKey)}
          </p>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 divide-y divide-gray-50 items-list"></div>`;
        groupsEl.appendChild(groupEl);
      }

      const listEl = groupEl.querySelector('.items-list')!;
      items.forEach((tx) => listEl.insertAdjacentHTML('beforeend', renderTxItem(tx)));
    });

    // Delegasi event hapus (hanya bind ke tombol baru)
    groupsEl.querySelectorAll('.btn-delete:not([data-bound])').forEach((btn) => {
      btn.setAttribute('data-bound', '1');
      btn.addEventListener('click', async () => {
        const id  = (btn as HTMLElement).dataset.id!;
        const row = document.querySelector(`[data-tx-id="${id}"]`);
        if (!confirm('Hapus transaksi ini?')) return;

        (btn as HTMLElement).textContent = '...';
        const { error } = await supabase.from('transactions').delete().eq('id', id);

        if (error) {
          toast('Gagal menghapus transaksi.', 'error');
          (btn as HTMLElement).textContent = 'Hapus';
        } else {
          row?.remove();
          toast('Transaksi dihapus.', 'success');
          const parent = row?.closest('[data-date]');
          if (parent && parent.querySelector('.items-list')?.children.length === 0) {
            parent.remove();
          }
          if (!groupsEl.children.length) {
            groupsEl.classList.add('hidden');
            emptyEl.classList.remove('hidden');
          }
          // Perbarui ringkasan setelah hapus
          await updateSummary(activeFrom, activeTo);
        }
      });
    });
  }

  // ── Render satu item transaksi ────────────────────────────
  function renderTxItem(tx: Transaction): string {
    const cat      = tx.categories;
    const isIncome = cat?.type === 'income';
    const icon     = cat?.icon || '📦';
    const name     = cat?.name || 'Lainnya';
    const sign     = isIncome ? '+' : '-';
    const color    = isIncome ? 'text-emerald-600' : 'text-rose-600';

    return `
      <div class="flex items-center gap-3 px-4 py-3" data-tx-id="${tx.id}">
        <span class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-xl shrink-0">${icon}</span>
        <div class="flex-1 min-w-0">
          <p class="text-gray-900 text-sm font-medium truncate">${name}</p>
          <p class="text-gray-400 text-xs truncate">${tx.description || '—'}</p>
        </div>
        <div class="text-right shrink-0">
          <p class="font-semibold text-sm ${color}">${sign}${formatRupiah(tx.amount)}</p>
          <button class="btn-delete text-gray-300 hover:text-rose-500 text-xs mt-0.5 transition-colors"
            data-id="${tx.id}">Hapus</button>
        </div>
      </div>`;
  }

  // ── Switcher pills ────────────────────────────────────────
  function setMode(newMode: FilterMode) {
    mode = newMode;

    document.querySelectorAll('.filter-pill').forEach((btn) => {
      const m = (btn as HTMLElement).dataset.mode as FilterMode;
      btn.className = m === mode
        ? 'filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-blue-600 text-white shadow-sm'
        : 'filter-pill shrink-0 px-4 py-1.5 text-xs font-semibold rounded-full transition-all bg-gray-100 text-gray-500 hover:bg-gray-200';
    });

    document.getElementById('input-pilih-bulan')!.classList.toggle('hidden', mode !== 'pilih-bulan');
    document.getElementById('input-custom')!.classList.toggle('hidden',       mode !== 'custom');

    // Fetch langsung kecuali mode yang menunggu input user
    if (mode !== 'pilih-bulan' && mode !== 'custom') fetchTransactions(false);
  }

  // Event: klik pill
  document.querySelectorAll('.filter-pill').forEach((btn) => {
    btn.addEventListener('click', () => setMode((btn as HTMLElement).dataset.mode as FilterMode));
  });

  // Event: pilih bulan
  monthPickerEl.addEventListener('change', () => fetchTransactions(false));

  // Event: custom range (debounce 600ms)
  let debounceTimer: ReturnType<typeof setTimeout>;
  [customFromEl, customToEl].forEach((el) => {
    el.addEventListener('change', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => fetchTransactions(false), 600);
    });
  });

  // Event: load more
  btnLoadMore.addEventListener('click', () => fetchTransactions(true));

  // ── Load awal ─────────────────────────────────────────────
  fetchTransactions(false);
</script>
