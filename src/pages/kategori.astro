---
import AppLayout from '../layouts/AppLayout.astro';
import EmptyState from '../components/ui/EmptyState.astro';
import Toast from '../components/ui/Toast.astro';
---

<AppLayout title="Kategori" activeNav="kategori">
  <Toast />

  <header class="px-4 pt-8 pb-4 flex items-center justify-between">
    <div>
      <h1 class="text-gray-900 font-bold text-xl">Kategori</h1>
      <p class="text-gray-400 text-sm mt-0.5">Kelola kategori transaksi</p>
    </div>
    <button id="btn-tambah-kategori" title="Tambah Kategori"
      class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center hover:bg-blue-700 transition-colors active:scale-95">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
    </button>
  </header>

  <!-- Tab -->
  <div class="px-4 mb-4">
    <div class="flex bg-gray-100 rounded-xl p-1 gap-1">
      <button id="tab-expense" onclick="switchTab('expense')"
        class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all bg-white text-rose-600 shadow-sm">
        💸 Pengeluaran
      </button>
      <button id="tab-income" onclick="switchTab('income')"
        class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500">
        💰 Pemasukan
      </button>
    </div>
  </div>

  <!-- List Pengeluaran -->
  <div id="list-expense" class="px-4 flex flex-col gap-2">
    <div id="empty-expense" class="hidden">
      <EmptyState icon="📂" title="Belum ada kategori pengeluaran" description="Tekan + untuk menambahkan kategori baru." />
    </div>

    <div id="items-expense" class="flex flex-col gap-2">
      <div class="py-8 flex justify-center">
        <svg class="w-6 h-6 animate-spin text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
        </svg>
      </div>
    </div>
  </div>

  <!-- List Pemasukan -->
  <div id="list-income" class="px-4 flex-col gap-2 hidden">
    <div id="empty-income" class="hidden">
      <EmptyState icon="📂" title="Belum ada kategori pemasukan" description="Tekan + untuk menambahkan kategori baru." />
    </div>
    <div id="items-income" class="flex flex-col gap-2"></div>
  </div>

  <!-- Modal Tambah / Edit -->
  <div id="modal-kategori" class="hidden fixed inset-0 z-50 flex items-end justify-center" onclick="handleModalClick(event)">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
    <div class="relative w-full max-w-md bg-white rounded-t-3xl px-6 pt-6 pb-10 shadow-2xl">
      <div class="w-10 h-1 bg-gray-200 rounded-full mx-auto mb-5"></div>
      <h2 id="modal-title" class="text-gray-900 font-bold text-lg mb-5">Tambah Kategori</h2>

      <form id="form-kategori" class="flex flex-col gap-4" novalidate>
        <input type="hidden" id="kategori-id" name="id" value="" />

        <!-- Emoji -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Ikon (Emoji)</label>
          <div class="flex items-center gap-3">
            <span id="preview-emoji" class="text-3xl w-12 h-12 bg-gray-100 rounded-xl flex items-center justify-center cursor-pointer select-none">📦</span>
            <input id="input-emoji" type="text" name="icon" placeholder="Ketik emoji..." maxlength="4" value="📦"
              class="flex-1 px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
          </div>
        </div>

        <!-- Nama -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="input-nama-kategori">
            Nama Kategori <span class="text-rose-500">*</span>
          </label>
          <input id="input-nama-kategori" type="text" name="name" placeholder="Contoh: Makan Siang, Transportasi..." required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>

        <button type="submit" id="btn-simpan-kategori"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:pointer-events-none">
          Simpan
        </button>
      </form>
    </div>
  </div>
</AppLayout>

<script>
  import { supabase }    from '../lib/supabase';
  import { requireAuth } from '../lib/auth-guard';
  import type { Category } from '../lib/types';

  const toast = (msg: string, type: 'success'|'error'|'info' = 'info') =>
    (window as any).showToast?.(msg, type);

  // ── Auth guard ────────────────────────────────────────────
  const session = await requireAuth();
  if (!session) throw new Error('redirect');

  // ── State ─────────────────────────────────────────────────
  let categories: Category[] = [];
  let activeTab: 'expense' | 'income' = 'expense';

  // ── Fetch semua kategori ──────────────────────────────────
  async function loadCategories() {
    const { data, error } = await supabase
      .from('categories')
      .select('*')
      .eq('user_id', session.user.id)
      .order('name');

    if (error) { toast('Gagal memuat kategori.', 'error'); return; }
    categories = (data ?? []) as Category[];
    renderList('expense');
    renderList('income');
  }

  // ── Render list ───────────────────────────────────────────
  function renderList(type: 'expense' | 'income') {
    const itemsEl = document.getElementById(`items-${type}`)!;
    const emptyEl = document.getElementById(`empty-${type}`)!;
    const filtered = categories.filter((c) => c.type === type);

    if (filtered.length === 0) {
      itemsEl.innerHTML = '';
      emptyEl.classList.remove('hidden');
      return;
    }

    emptyEl.classList.add('hidden');
    itemsEl.innerHTML = filtered.map((c) => `
      <div class="bg-white rounded-xl border border-gray-100 px-4 py-3 flex items-center justify-between" data-cat-id="${c.id}">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 bg-gray-50 rounded-xl flex items-center justify-center text-xl">${c.icon || '📦'}</span>
          <span class="text-gray-800 text-sm font-medium">${c.name}</span>
        </div>
        <div class="flex gap-2">
          <button class="btn-edit w-7 h-7 flex items-center justify-center text-gray-400 hover:text-blue-600 transition-colors" data-id="${c.id}" title="Edit">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
          </button>
          <button class="btn-delete-cat w-7 h-7 flex items-center justify-center text-gray-400 hover:text-rose-600 transition-colors" data-id="${c.id}" title="Hapus">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
      </div>`).join('');

    // Edit buttons
    itemsEl.querySelectorAll('.btn-edit').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id  = (btn as HTMLElement).dataset.id!;
        const cat = categories.find((c) => c.id === id);
        if (!cat) return;
        openModal(cat);
      });
    });

    // Delete buttons
    itemsEl.querySelectorAll('.btn-delete-cat').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id!;
        if (!confirm('Hapus kategori ini? Transaksi yang menggunakan kategori ini tidak akan ikut terhapus.')) return;

        const { error } = await supabase.from('categories').delete().eq('id', id);
        if (error) {
          toast('Gagal menghapus kategori.', 'error');
        } else {
          toast('Kategori dihapus.', 'success');
          await loadCategories();
        }
      });
    });
  }

  // ── Tab switcher ──────────────────────────────────────────
  function switchTab(tab: 'expense' | 'income') {
    activeTab = tab;
    const listE  = document.getElementById('list-expense')!;
    const listI  = document.getElementById('list-income')!;
    const tabE   = document.getElementById('tab-expense')!;
    const tabI   = document.getElementById('tab-income')!;

    if (tab === 'expense') {
      listE.classList.remove('hidden'); listI.classList.add('hidden');
      tabE.className = 'flex-1 py-2 text-sm font-semibold rounded-lg transition-all bg-white text-rose-600 shadow-sm';
      tabI.className = 'flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500';
    } else {
      listI.classList.replace('hidden', 'flex'); listE.classList.add('hidden');
      tabI.className = 'flex-1 py-2 text-sm font-semibold rounded-lg transition-all bg-white text-emerald-600 shadow-sm';
      tabE.className = 'flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500';
    }
  }
  (window as any).switchTab = switchTab;

  // ── Modal helpers ─────────────────────────────────────────
  function openModal(cat?: Category) {
    const modal      = document.getElementById('modal-kategori')!;
    const titleEl    = document.getElementById('modal-title')!;
    const idInput    = document.getElementById('kategori-id') as HTMLInputElement;
    const nameInput  = document.getElementById('input-nama-kategori') as HTMLInputElement;
    const emojiInput = document.getElementById('input-emoji') as HTMLInputElement;
    const previewEl  = document.getElementById('preview-emoji')!;

    if (cat) {
      titleEl.textContent    = 'Edit Kategori';
      idInput.value          = cat.id;
      nameInput.value        = cat.name;
      emojiInput.value       = cat.icon || '📦';
      previewEl.textContent  = cat.icon || '📦';
    } else {
      titleEl.textContent    = 'Tambah Kategori';
      idInput.value          = '';
      nameInput.value        = '';
      emojiInput.value       = '📦';
      previewEl.textContent  = '📦';
    }
    modal.classList.remove('hidden');
    setTimeout(() => nameInput.focus(), 100);
  }

  function closeModal() {
    document.getElementById('modal-kategori')!.classList.add('hidden');
  }

  function handleModalClick(e: MouseEvent) {
    if ((e.target as HTMLElement).id === 'modal-kategori') closeModal();
  }
  (window as any).handleModalClick = handleModalClick;

  document.getElementById('btn-tambah-kategori')?.addEventListener('click', () => openModal());

  // Sync emoji preview
  document.getElementById('input-emoji')?.addEventListener('input', (e) => {
    document.getElementById('preview-emoji')!.textContent =
      (e.target as HTMLInputElement).value || '📦';
  });

  // ── Form submit ───────────────────────────────────────────
  document.getElementById('form-kategori')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id    = (document.getElementById('kategori-id')         as HTMLInputElement).value;
    const name  = (document.getElementById('input-nama-kategori') as HTMLInputElement).value.trim();
    const icon  = (document.getElementById('input-emoji')         as HTMLInputElement).value.trim();
    const btn   = document.getElementById('btn-simpan-kategori')  as HTMLButtonElement;

    if (!name) return toast('Nama kategori tidak boleh kosong.', 'error');

    btn.disabled    = true;
    btn.textContent = 'Menyimpan...';

    let error: any;

    if (id) {
      // Update
      ({ error } = await supabase
        .from('categories')
        .update({ name, icon: icon || null })
        .eq('id', id));
    } else {
      // Insert
      ({ error } = await supabase
        .from('categories')
        .insert({ user_id: session.user.id, name, type: activeTab, icon: icon || null }));
    }

    btn.disabled    = false;
    btn.textContent = 'Simpan';

    if (error) {
      toast('Gagal menyimpan kategori.', 'error');
    } else {
      toast(id ? 'Kategori diperbarui!' : 'Kategori ditambahkan!', 'success');
      closeModal();
      await loadCategories();
    }
  });

  // ── Initial load ──────────────────────────────────────────
  loadCategories();
</script>
