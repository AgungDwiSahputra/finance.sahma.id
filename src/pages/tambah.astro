---
import AppLayout from '../layouts/AppLayout.astro';
import Card from '../components/ui/Card.astro';
import Toast from '../components/ui/Toast.astro';
---

<AppLayout title="Tambah Transaksi" activeNav="tambah">
  <Toast />

  <!-- Header -->
  <header class="px-4 pt-8 pb-4">
    <h1 class="text-gray-900 font-bold text-xl">Tambah Transaksi</h1>
    <p class="text-gray-400 text-sm mt-0.5">Catat pemasukan atau pengeluaran</p>
  </header>

  <div class="px-4">
    <Card>
      <form id="form-transaksi" novalidate class="flex flex-col gap-5">

        <!-- Toggle Tipe: Pengeluaran / Pemasukan -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Tipe Transaksi</label>
          <div class="flex bg-gray-100 rounded-xl p-1 gap-1" id="type-toggle">
            <button
              type="button"
              data-type="expense"
              id="btn-expense"
              class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-rose-600 text-white shadow-sm"
              onclick="setType('expense')"
            >
              💸 Pengeluaran
            </button>
            <button
              type="button"
              data-type="income"
              id="btn-income"
              class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-gray-500"
              onclick="setType('income')"
            >
              💰 Pemasukan
            </button>
          </div>
          <input type="hidden" id="input-type" name="type" value="expense" />
        </div>

        <!-- Nominal -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="input-amount">
            Nominal <span class="text-rose-500">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400 text-sm font-medium">Rp</span>
            <input
              id="input-amount"
              type="number"
              name="amount"
              placeholder="0"
              min="1"
              required
              inputmode="numeric"
              class="w-full pl-10 pr-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
            />
          </div>
          <p id="error-amount" class="text-rose-500 text-xs mt-1 hidden">Nominal harus lebih dari 0.</p>
        </div>

        <!-- Kategori -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="input-category">
            Kategori <span class="text-rose-500">*</span>
          </label>
          <select
            id="input-category"
            name="category_id"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all bg-white appearance-none"
          >
            <option value="" disabled selected>Pilih kategori...</option>
            <!-- Diisi dinamis dari Supabase di Langkah 5 -->
          </select>
          <p id="error-category" class="text-rose-500 text-xs mt-1 hidden">Pilih kategori terlebih dahulu.</p>
        </div>

        <!-- Tanggal -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="input-date">
            Tanggal
          </label>
          <input
            id="input-date"
            type="date"
            name="transaction_date"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <!-- Catatan (opsional) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="input-desc">
            Catatan <span class="text-gray-400 font-normal">(opsional)</span>
          </label>
          <textarea
            id="input-desc"
            name="description"
            placeholder="Misal: makan siang bersama tim..."
            rows="2"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-none"
          ></textarea>
        </div>

        <!-- Tombol Simpan -->
        <button
          type="submit"
          id="btn-simpan"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50 disabled:pointer-events-none"
        >
          Simpan Transaksi
        </button>

      </form>
    </Card>
  </div>

</AppLayout>

<script>
  // Set tanggal default ke hari ini
  const inputDate = document.getElementById('input-date') as HTMLInputElement;
  if (inputDate) {
    inputDate.value = new Date().toISOString().split('T')[0];
  }

  function setType(type: 'expense' | 'income') {
    const btnExpense = document.getElementById('btn-expense')!;
    const btnIncome  = document.getElementById('btn-income')!;
    const inputType  = document.getElementById('input-type') as HTMLInputElement;

    inputType.value = type;

    if (type === 'expense') {
      btnExpense.className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-rose-600 text-white shadow-sm';
      btnIncome.className  = 'flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-gray-500';
    } else {
      btnIncome.className  = 'flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all bg-emerald-600 text-white shadow-sm';
      btnExpense.className = 'flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all text-gray-500';
    }
  }

  // Validasi client-side sebelum submit
  const form = document.getElementById('form-transaksi') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const amount   = (document.getElementById('input-amount')   as HTMLInputElement).value;
    const category = (document.getElementById('input-category') as HTMLSelectElement).value;
    const errAmt   = document.getElementById('error-amount')!;
    const errCat   = document.getElementById('error-category')!;

    let valid = true;

    if (!amount || Number(amount) <= 0) {
      errAmt.classList.remove('hidden');
      valid = false;
    } else {
      errAmt.classList.add('hidden');
    }

    if (!category) {
      errCat.classList.remove('hidden');
      valid = false;
    } else {
      errCat.classList.add('hidden');
    }

    if (!valid) return;

    // Logika submit Supabase akan disambungkan di Langkah 5
    console.log('[Form] Validasi lulus — akan submit ke Supabase di Langkah 5');
  });

  (window as any).setType = setType;
</script>
