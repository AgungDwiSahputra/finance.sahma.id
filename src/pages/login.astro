---
import BaseLayout from '../layouts/BaseLayout.astro';
import Toast from '../components/ui/Toast.astro';
---

<BaseLayout title="Masuk">
  <Toast />
  <div class="min-h-screen bg-gradient-to-br from-blue-600 to-blue-800 flex items-end justify-center">

    <!-- Hero Section -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 pointer-events-none select-none px-8 pb-72">
      <div class="w-16 h-16 bg-white/20 backdrop-blur rounded-2xl flex items-center justify-center">
        <span class="text-3xl">💰</span>
      </div>
      <h1 class="text-white text-2xl font-bold tracking-tight">Keuanganku</h1>
      <p class="text-blue-200 text-sm text-center">Kelola keuangan pribadi lebih cerdas</p>
    </div>

    <!-- Card Form -->
    <div class="relative w-full max-w-md bg-white rounded-t-3xl px-6 pt-8 pb-10 shadow-2xl">

      <!-- Tab Masuk / Daftar -->
      <div class="flex bg-gray-100 rounded-xl p-1 mb-6" id="tab-container">
        <button
          id="tab-masuk"
          class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all bg-white text-blue-600 shadow-sm"
          onclick="switchTab('masuk')"
        >
          Masuk
        </button>
        <button
          id="tab-daftar"
          class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500"
          onclick="switchTab('daftar')"
        >
          Daftar
        </button>
      </div>

      <!-- Form Masuk -->
      <form id="form-masuk" class="flex flex-col gap-4" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="masuk-email">
            Email
          </label>
          <input
            id="masuk-email"
            type="email"
            placeholder="nama@email.com"
            autocomplete="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-sm font-medium text-gray-700" for="masuk-password">
              Password
            </label>
            <button type="button" id="btn-magic-link" class="text-xs text-blue-600 hover:underline">
              Kirim Magic Link
            </button>
          </div>
          <input
            id="masuk-password"
            type="password"
            placeholder="Minimal 6 karakter"
            autocomplete="current-password"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <button
          type="submit"
          id="btn-masuk"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2 disabled:opacity-50 disabled:pointer-events-none"
        >
          Masuk
        </button>
      </form>

      <!-- Form Daftar -->
      <form id="form-daftar" class="flex-col gap-4 hidden" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-nama">
            Nama Lengkap
          </label>
          <input
            id="daftar-nama"
            type="text"
            placeholder="Nama Anda"
            autocomplete="name"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-email">
            Email
          </label>
          <input
            id="daftar-email"
            type="email"
            placeholder="nama@email.com"
            autocomplete="email"
            required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-password">
            Password
          </label>
          <input
            id="daftar-password"
            type="password"
            placeholder="Minimal 6 karakter"
            autocomplete="new-password"
            required
            minlength="6"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
          />
        </div>

        <button
          type="submit"
          id="btn-daftar"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2 disabled:opacity-50 disabled:pointer-events-none"
        >
          Buat Akun
        </button>
      </form>

    </div>
  </div>
</BaseLayout>

<script>
  function switchTab(tab: 'masuk' | 'daftar') {
    const formMasuk  = document.getElementById('form-masuk')!;
    const formDaftar = document.getElementById('form-daftar')!;
    const tabMasuk   = document.getElementById('tab-masuk')!;
    const tabDaftar  = document.getElementById('tab-daftar')!;

    if (tab === 'masuk') {
      formMasuk.classList.replace('hidden', 'flex');
      formDaftar.classList.replace('flex', 'hidden');
      tabMasuk.classList.add('bg-white', 'text-blue-600', 'shadow-sm');
      tabMasuk.classList.remove('text-gray-500');
      tabDaftar.classList.remove('bg-white', 'text-blue-600', 'shadow-sm');
      tabDaftar.classList.add('text-gray-500');
    } else {
      formDaftar.classList.replace('hidden', 'flex');
      formMasuk.classList.replace('flex', 'hidden');
      tabDaftar.classList.add('bg-white', 'text-blue-600', 'shadow-sm');
      tabDaftar.classList.remove('text-gray-500');
      tabMasuk.classList.remove('bg-white', 'text-blue-600', 'shadow-sm');
      tabMasuk.classList.add('text-gray-500');
    }
  }

  // Ekspor ke window untuk onclick inline
  (window as any).switchTab = switchTab;
</script>
