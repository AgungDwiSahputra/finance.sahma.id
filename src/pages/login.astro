---
import BaseLayout from '../layouts/BaseLayout.astro';
import Toast from '../components/ui/Toast.astro';
---

<BaseLayout title="Masuk">
  <Toast />
  <div class="min-h-screen bg-gradient-to-br from-blue-600 to-blue-800 flex items-end justify-center">

    <!-- Hero -->
    <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 pointer-events-none select-none px-8 pb-72">
      <div class="w-16 h-16 bg-white/20 backdrop-blur rounded-2xl flex items-center justify-center">
        <span class="text-3xl">💰</span>
      </div>
      <h1 class="text-white text-2xl font-bold tracking-tight">Keuanganku</h1>
      <p class="text-blue-200 text-sm text-center">Kelola keuangan pribadi lebih cerdas</p>
    </div>

    <!-- Card Form -->
    <div class="relative w-full max-w-md bg-white rounded-t-3xl px-6 pt-8 pb-10 shadow-2xl">

      <!-- Tab -->
      <div class="flex bg-gray-100 rounded-xl p-1 mb-6">
        <button id="tab-masuk"  class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all bg-white text-blue-600 shadow-sm" onclick="switchTab('masuk')">Masuk</button>
        <button id="tab-daftar" class="flex-1 py-2 text-sm font-semibold rounded-lg transition-all text-gray-500" onclick="switchTab('daftar')">Daftar</button>
      </div>

      <!-- Form Masuk -->
      <form id="form-masuk" class="flex flex-col gap-4" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="masuk-email">Email</label>
          <input id="masuk-email" type="email" placeholder="nama@email.com" autocomplete="email" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label class="text-sm font-medium text-gray-700" for="masuk-password">Password</label>
            <button type="button" id="btn-magic-link" class="text-xs text-blue-600 hover:underline">Kirim Magic Link</button>
          </div>
          <input id="masuk-password" type="password" placeholder="Minimal 6 karakter" autocomplete="current-password" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>
        <button type="submit" id="btn-masuk"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2 disabled:opacity-50 disabled:pointer-events-none">
          Masuk
        </button>
      </form>

      <!-- Form Daftar -->
      <form id="form-daftar" class="flex-col gap-4 hidden" novalidate>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-nama">Nama Lengkap</label>
          <input id="daftar-nama" type="text" placeholder="Nama Anda" autocomplete="name" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-email">Email</label>
          <input id="daftar-email" type="email" placeholder="nama@email.com" autocomplete="email" required
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1.5" for="daftar-password">Password</label>
          <input id="daftar-password" type="password" placeholder="Minimal 6 karakter" autocomplete="new-password" required minlength="6"
            class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
        </div>
        <button type="submit" id="btn-daftar"
          class="w-full bg-blue-600 text-white font-semibold py-3.5 rounded-xl hover:bg-blue-700 active:scale-[0.98] transition-all flex items-center justify-center gap-2 mt-2 disabled:opacity-50 disabled:pointer-events-none">
          Buat Akun
        </button>
      </form>

    </div>
  </div>
</BaseLayout>

<script>
  import { supabase }    from '../lib/supabase';
  import { requireGuest } from '../lib/auth-guard';

  // Redirect ke dashboard jika sudah login
  await requireGuest();

  // ── Helpers ──────────────────────────────────────────────
  const toast = (msg: string, type: 'success' | 'error' | 'info' = 'info') =>
    (window as any).showToast?.(msg, type);

  function setLoading(btnId: string, loading: boolean, label: string) {
    const btn = document.getElementById(btnId) as HTMLButtonElement;
    btn.disabled = loading;
    btn.innerHTML = loading
      ? `<svg class="w-4 h-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg> Memproses...`
      : label;
  }

  // ── Tab switcher ──────────────────────────────────────────
  function switchTab(tab: 'masuk' | 'daftar') {
    const fMasuk  = document.getElementById('form-masuk')!;
    const fDaftar = document.getElementById('form-daftar')!;
    const tMasuk  = document.getElementById('tab-masuk')!;
    const tDaftar = document.getElementById('tab-daftar')!;
    const active  = 'bg-white text-blue-600 shadow-sm';
    const inactive = 'text-gray-500';

    if (tab === 'masuk') {
      fMasuk.classList.replace('hidden', 'flex');
      fDaftar.classList.replace('flex', 'hidden');
      tMasuk.className  = `flex-1 py-2 text-sm font-semibold rounded-lg transition-all ${active}`;
      tDaftar.className = `flex-1 py-2 text-sm font-semibold rounded-lg transition-all ${inactive}`;
    } else {
      fDaftar.classList.replace('hidden', 'flex');
      fMasuk.classList.replace('flex', 'hidden');
      tDaftar.className = `flex-1 py-2 text-sm font-semibold rounded-lg transition-all ${active}`;
      tMasuk.className  = `flex-1 py-2 text-sm font-semibold rounded-lg transition-all ${inactive}`;
    }
  }
  (window as any).switchTab = switchTab;

  // ── Terjemahan error Supabase → Bahasa Indonesia ─────────
  function terjemahkanError(msg: string): string {
    if (msg.includes('Invalid login') || msg.includes('invalid_credentials'))
      return 'Email atau password salah.';
    if (msg.includes('Email not confirmed'))
      return 'Email belum dikonfirmasi. Buka inbox email Anda dan klik link verifikasi terlebih dahulu.';
    if (msg.includes('User already registered') || msg.includes('already been registered'))
      return 'Email ini sudah terdaftar. Silakan masuk atau gunakan email lain.';
    if (msg.includes('Too many requests') || msg.includes('over_email_send_rate_limit'))
      return 'Terlalu banyak percobaan. Tunggu beberapa saat lalu coba lagi.';
    if (msg.includes('Password should be') || msg.includes('password'))
      return 'Password terlalu lemah. Gunakan minimal 6 karakter.';
    if (msg.includes('Unable to validate') || msg.includes('network'))
      return 'Gagal terhubung ke server. Periksa koneksi internet Anda.';
    return msg;
  }

  // ── Form Masuk ────────────────────────────────────────────
  document.getElementById('form-masuk')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email    = (document.getElementById('masuk-email')    as HTMLInputElement).value.trim();
    const password = (document.getElementById('masuk-password') as HTMLInputElement).value;

    if (!email || !password) return toast('Isi email dan password terlebih dahulu.', 'error');

    setLoading('btn-masuk', true, 'Masuk');
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    setLoading('btn-masuk', false, 'Masuk');

    if (error) {
      toast(terjemahkanError(error.message), 'error');
    } else {
      window.location.replace('/');
    }
  });

  // ── Form Daftar ───────────────────────────────────────────
  document.getElementById('form-daftar')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fullName = (document.getElementById('daftar-nama')     as HTMLInputElement).value.trim();
    const email    = (document.getElementById('daftar-email')    as HTMLInputElement).value.trim();
    const password = (document.getElementById('daftar-password') as HTMLInputElement).value;

    if (!fullName || !email || !password) return toast('Semua kolom wajib diisi.', 'error');
    if (password.length < 6)             return toast('Password minimal 6 karakter.', 'error');

    setLoading('btn-daftar', true, 'Buat Akun');
    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { data: { full_name: fullName } },
    });
    setLoading('btn-daftar', false, 'Buat Akun');

    if (error) {
      toast(terjemahkanError(error.message), 'error');
    } else if (data.session) {
      // Email confirmation dinonaktifkan di Supabase → langsung masuk
      window.location.replace('/');
    } else {
      // Email confirmation aktif (default Supabase) → user harus verifikasi dulu
      showKonfirmasiInfo(email);
    }
  });

  // ── Banner konfirmasi email ───────────────────────────────
  function showKonfirmasiInfo(email: string) {
    // Pindah ke tab masuk dan pre-fill email
    switchTab('masuk');
    (document.getElementById('masuk-email') as HTMLInputElement).value = email;

    // Tampilkan banner info di atas form masuk
    const existing = document.getElementById('banner-konfirmasi');
    if (existing) existing.remove();

    const banner = document.createElement('div');
    banner.id = 'banner-konfirmasi';
    banner.className = 'bg-blue-50 border border-blue-200 rounded-xl px-4 py-3 flex gap-3 items-start mb-2';
    banner.innerHTML = `
      <span class="text-xl shrink-0">📧</span>
      <div class="flex-1">
        <p class="text-blue-800 text-sm font-semibold">Cek Email Anda!</p>
        <p class="text-blue-600 text-xs mt-0.5 leading-relaxed">
          Link verifikasi dikirim ke <strong>${email}</strong>.<br>
          Klik link tersebut, lalu kembali ke sini untuk masuk.
        </p>
      </div>
      <button onclick="this.parentElement.remove()" class="text-blue-400 hover:text-blue-600 shrink-0 text-lg leading-none">×</button>`;

    const formMasuk = document.getElementById('form-masuk')!;
    formMasuk.parentElement!.insertBefore(banner, formMasuk);
  }

  // ── Magic Link ────────────────────────────────────────────
  document.getElementById('btn-magic-link')?.addEventListener('click', async () => {
    const email = (document.getElementById('masuk-email') as HTMLInputElement).value.trim();
    if (!email) return toast('Masukkan email Anda terlebih dahulu.', 'error');

    const { error } = await supabase.auth.signInWithOtp({ email });
    if (error) {
      toast(error.message, 'error');
    } else {
      toast(`Magic link dikirim ke ${email}. Periksa inbox Anda.`, 'success');
    }
  });
</script>
