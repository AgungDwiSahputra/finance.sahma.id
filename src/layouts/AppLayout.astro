---
import BaseLayout from './BaseLayout.astro';
import BottomNav from '../components/ui/BottomNav.astro';

interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'riwayat' | 'kategori' | 'insights';
  showFab?: boolean;
}

const { title, activeNav, showFab = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={title}>
  <div class="min-h-screen flex flex-col">
    <main class="flex-1 max-w-md mx-auto w-full pb-24">
      <slot />
    </main>

    {showFab && (
      <div class="fixed bottom-20 left-0 right-0 z-50 pointer-events-none">
        <div class="max-w-md mx-auto px-4 flex justify-end">
          <a
            href={`${base}tambah`}
            class="pointer-events-auto w-14 h-14 bg-blue-600 rounded-full shadow-xl flex items-center justify-center hover:bg-blue-700 active:scale-95 transition-all"
            aria-label="Tambah Transaksi"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </a>
        </div>
      </div>
    )}

    <BottomNav active={activeNav} />
  </div>
</BaseLayout>
