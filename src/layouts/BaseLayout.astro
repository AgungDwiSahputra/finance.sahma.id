---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fintar',
  description = 'Fintar — Catat Keuangan, Semudah Bercerita. Sistem pengelolaan keuangan pribadi mobile-first dengan Smart Input AI.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2563eb" />
    <meta name="application-name" content="Fintar" />
    <meta property="og:title" content={`${title} — Fintar`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}logo.webp`} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}logo_mini.webp`} />
    <title>{title} — Fintar</title>
  </head>
  <body class="bg-slate-50 text-gray-900 antialiased">
    <slot />
  </body>
</html>
