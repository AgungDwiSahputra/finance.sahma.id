---
interface Props {
  icon?: string;
  title: string;
  description?: string;
  actionLabel?: string;
  actionHref?: string;
}

const {
  icon = '📭',
  title,
  description,
  actionLabel,
  actionHref,
} = Astro.props;
---

<div class="flex flex-col items-center justify-center py-16 px-6 text-center">
  <span class="text-5xl mb-4" role="img">{icon}</span>
  <h3 class="text-gray-700 font-semibold text-base mb-1">{title}</h3>
  {description && (
    <p class="text-gray-400 text-sm leading-relaxed mb-6">{description}</p>
  )}
  {actionLabel && actionHref && (
    <a
      href={actionHref}
      class="inline-flex items-center gap-2 bg-blue-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-blue-700 transition-colors"
    >
      {actionLabel}
    </a>
  )}
</div>
