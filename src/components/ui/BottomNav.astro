---
interface Props {
  active?: 'dashboard' | 'tambah' | 'riwayat' | 'kategori';
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL;

const linkClass = (name: string) =>
  `flex flex-col items-center gap-1 text-xs font-medium transition-colors ${
    active === name ? 'text-blue-600' : 'text-gray-400 hover:text-gray-600'
  }`;
---

<nav class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 safe-area-pb">
  <div class="max-w-md mx-auto flex items-end justify-around px-2 h-16">

    <!-- Dashboard -->
    <a href={base} class={linkClass('dashboard')}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Dashboard</span>
    </a>

    <!-- Tombol Tambah (center, elevated) -->
    <a href={`${base}tambah`} class="relative -top-5 flex flex-col items-center gap-1">
      <span class={`w-14 h-14 rounded-full flex items-center justify-center shadow-lg transition-transform active:scale-95 ${
        active === 'tambah' ? 'bg-blue-700' : 'bg-blue-600'
      }`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </span>
      <span class={`text-xs font-medium ${active === 'tambah' ? 'text-blue-600' : 'text-gray-400'}`}>Tambah</span>
    </a>

    <!-- Riwayat -->
    <a href={`${base}riwayat`} class={linkClass('riwayat')}>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
      </svg>
      <span>Riwayat</span>
    </a>

  </div>
</nav>

<style>
  .safe-area-pb {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
