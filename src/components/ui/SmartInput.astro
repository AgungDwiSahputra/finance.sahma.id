---
// Komponen UI-only untuk Smart Input AI.
// Semua logika JS ditangani oleh script di tambah.astro
// agar bisa mengakses variabel `categories` dan `supabase` yang sudah ada.
---

<div class="px-4 mb-3">
  <div class="bg-gradient-to-br from-blue-50 to-indigo-50 border border-blue-100 rounded-2xl p-4">

    <!-- Header -->
    <div class="flex items-center gap-2 mb-3">
      <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2a1 1 0 0 1 .894.553l2.382 4.795 5.32.766a1 1 0 0 1 .554 1.706l-3.85 3.746.91 5.293a1 1 0 0 1-1.451 1.054L12 17.347l-4.759 2.566a1 1 0 0 1-1.45-1.054l.908-5.293L2.85 9.82a1 1 0 0 1 .554-1.706l5.32-.766L11.106 2.553A1 1 0 0 1 12 2Z"/>
        </svg>
      </div>
      <div>
        <p class="text-sm font-semibold text-blue-900">Smart Input AI</p>
        <p class="text-xs text-blue-500">Ceritakan transaksimu, AI akan mengisinya otomatis</p>
      </div>
    </div>

    <!-- Textarea -->
    <textarea
      id="smart-prompt-text"
      rows="3"
      placeholder="Contoh: beli beras 50rb, sabun 15rb, minyak 30rb di Alfamart tadi sore..."
      class="w-full px-3.5 py-3 rounded-xl border border-blue-200 bg-white text-sm text-gray-800 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all resize-none"
    ></textarea>

    <!-- Error message -->
    <p id="smart-prompt-error" class="hidden text-xs text-rose-500 mt-1.5 px-1"></p>

    <!-- Tombol Deteksi AI -->
    <button
      type="button"
      id="smart-prompt-btn"
      disabled
      class="mt-2.5 w-full flex items-center justify-center gap-2 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-semibold transition-all hover:bg-blue-700 active:scale-[0.98] disabled:opacity-40 disabled:pointer-events-none"
    >
      <!-- Icon default (bintang / sparkle) -->
      <svg id="smart-prompt-icon" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2a1 1 0 0 1 .894.553l2.382 4.795 5.32.766a1 1 0 0 1 .554 1.706l-3.85 3.746.91 5.293a1 1 0 0 1-1.451 1.054L12 17.347l-4.759 2.566a1 1 0 0 1-1.45-1.054l.908-5.293L2.85 9.82a1 1 0 0 1 .554-1.706l5.32-.766L11.106 2.553A1 1 0 0 1 12 2Z"/>
      </svg>
      <!-- Spinner (tersembunyi saat idle) -->
      <svg id="smart-prompt-spinner" xmlns="http://www.w3.org/2000/svg" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/>
      </svg>
      <span id="smart-prompt-label">Deteksi AI</span>
    </button>

  </div>
</div>
